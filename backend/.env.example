# 复制为 backend/.env 后填写真实值（backend/.env 已被 .gitignore 排除，永远不要提交）
# 容器通过 docker-compose 的 env_file 读取本文件；改完 .env 需要重建容器才生效：
#   docker compose up -d --force-recreate backend worker beat

# 数据库 / 队列（Docker 下由 compose 的 x-common-env 覆盖，本地跑服务时才需要）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_novel
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 浏览器 cookie 加密（发布器用）
COOKIE_ENCRYPTION_KEY=change-me-32-bytes

# 模型服务
DASHSCOPE_API_KEY1=
AGNES_KEY=
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# sieve 抓取 API（https://scrape.usesieve.com）
# 密钥有整账号权限且无 scope，**只在服务端使用**：不要出现在浏览器/移动端包、
# 日志、错误上报或 git 里。用 backend/scripts/sieve_device_login.py 走一次设备登录
# 授权即可自动写入本文件（脚本不会打印密钥）。
SIEVE_BASE_URL=https://scrape.usesieve.com
SIEVE_API_KEY=
